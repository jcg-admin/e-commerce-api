#!/bin/bash
# =============================================================================
# api/.githooks/pre-commit — gates de calidad de codigo
# =============================================================================
# Cargado via 'git config core.hooksPath .githooks' dentro del repo api/.
# El parent repo (.githooks/commit-msg) valida convencion de commit
# message; este pre-commit valida contenido de los .py staged.
#
# Activacion:
#   cd /home/user/kaupamex/api
#   git config core.hooksPath .githooks
#
# Gates activos:
#
#   1. Zero lazy imports en src/addons/** (PEP 8).
#      Iniciativa: docs/source/gestion/pm/api/iniciativas/
#                  eliminar-lazy-imports-pep8/
#      Script:     scripts/check_no_lazy_imports.py
#
# Skip manual: 'git commit --no-verify' (solo emergencias documentadas).
# =============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
EXIT_CODE=0

# ─── El alcance que comparten TODOS los gates de abajo ───────────────────────
# Las tres raíces son las que `check_no_lazy_imports.py` declara en su
# DEFAULT_ROOTS: el código de la app. `addons/` faltaba desde que #317 movió
# ahí los 90 addons de comunidad, y con él se fue el 69 % del árbol —
# 550 de 2171 archivos vigilados, medido en H-API-759. Un gate que no cubre no
# falla: calla, y su OK se lee como árbol limpio.
#
# `scripts/` y `src/manage.py` quedan FUERA a propósito, no por olvido: son
# entrypoints que fijan DJANGO_SETTINGS_MODULE antes de importar Django, así
# que su import diferido es el constraint del framework — el propio template
# `manage.py-tpl` de Django lo escribe así.
#
# El pathspec dice `src/***.py`, no `src/addons/***.py`, y la corrección es de
# 2026-09-03 (#324): el guion ya declaraba `DEFAULT_ROOTS = ('src', 'addons',
# 'tests')` desde las tareas #115 y #133, pero el hook seguía entregándole sólo
# `src/addons`. Consecuencia medida: **85 archivos** de `src/orm` (29),
# `src/tools` (38), `src/service` (7) y `src/config` (11) no llegaban a
# NINGUNO de los gates de abajo al commitearse — las raíces de framework, que
# es donde vive el ORM espejado. Es literalmente el defecto que el párrafo de
# arriba describe para `addons/`, repetido un nivel más adentro: el guion sabía
# medir y el hook no le pasaba qué medir. Los 85 se midieron limpios contra los
# cuatro gates que corren sin base de datos antes de ensanchar el pathspec, así
# que ensancharlo no introduce rojo; lo que introduce es cobertura.
STAGED_PY=()
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    STAGED_PY+=("$line")
done < <(
    git diff --cached --name-only --diff-filter=ACM \
        -- 'src/***.py' 'addons/***.py' 'tests/***.py' 2>/dev/null \
    | grep -vE 'migrations/|__pycache__|^src/manage\.py$' || true
)

if [[ "${#STAGED_PY[@]}" -gt 0 ]]; then
    CHECKER="$REPO_ROOT/scripts/check_no_lazy_imports.py"
    if [[ ! -f "$CHECKER" ]]; then
        echo "pre-commit: $CHECKER no encontrado — skip lazy import gate" >&2
    else
        python3 "$CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── Gate 2: canon-idioma en values de identifier (EN canonico) ──────────────
# Iniciativa: docs/source/gestion/pm/api/iniciativas/
#             canon-idioma-enums-error-codes/
# Script:     docs/scripts/check_canon_language.py (cross-submodule).
# Allowlist:  docs/scripts/canon-idioma-allowlist.txt.
# El gate aplica solo cuando hay .py staged en addons/.
# El clon hermano de docs se llama `kaupamex-docs` desde el rename de repos
# (DEC-KX-06); la ruta `../docs` que este gate usaba dejo de existir y el gate
# degradaba a skip silencioso — H-API-109. Se prueban los nombres conocidos en
# vez de asumir uno.
if [[ "${#STAGED_PY[@]}" -gt 0 ]]; then
    CANON_CHECKER=""
    for CANDIDATO in kaupamex-docs docs e-commerce-docs; do
        if [[ -f "$REPO_ROOT/../$CANDIDATO/scripts/check_canon_language.py" ]]; then
            CANON_CHECKER="$REPO_ROOT/../$CANDIDATO/scripts/check_canon_language.py"
            CANON_ROOT="$REPO_ROOT/.."
            break
        fi
    done
    if [[ -z "$CANON_CHECKER" ]]; then
        echo "pre-commit: clon de docs no encontrado — skip canon-idioma gate" >&2
    else
        python3 "$CANON_CHECKER" --repo-root "$CANON_ROOT" || EXIT_CODE=1
    fi
fi

# ─── Gate 3: silencios de excepción justificados (AC uc-sys-06) ──────────────
# Todo ``except: pass`` / ``...`` debe llevar ``# silent OK because <razon>``.
# Script: scripts/check_silent_oks.py.
if [[ "${#STAGED_PY[@]}" -gt 0 ]]; then
    SILENT_CHECKER="$REPO_ROOT/scripts/check_silent_oks.py"
    if [[ ! -f "$SILENT_CHECKER" ]]; then
        echo "pre-commit: $SILENT_CHECKER no encontrado — skip silent-OK gate" >&2
    else
        python3 "$SILENT_CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── Gate 4: identificadores en inglés, comentarios en español ───────────────
# Directiva reiterada del ejecutor; vivía sólo en prosa y hubo que corregirla a
# mano en medio de una tarea, que es el coste que este gate elimina.
# Script: scripts/check_identifier_language.py (con baseline de deuda heredada).
if [[ "${#STAGED_PY[@]}" -gt 0 ]]; then
    LANG_CHECKER="$REPO_ROOT/scripts/check_identifier_language.py"
    if [[ ! -f "$LANG_CHECKER" ]]; then
        echo "pre-commit: $LANG_CHECKER no encontrado — skip idioma gate" >&2
    else
        python3 "$LANG_CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── Gate 5: ningun identificador lleva el nombre de la referencia ───────────
# Directiva del ejecutor 2026-09-02: "En nuestra api, ningun archivo, clase,
# funcion o firma de funcion, debe de tener odoo-*". Este arbol ADAPTA la
# referencia; un simbolo nuestro con su nombre hace pasar por prestada una
# pieza que es del producto. El caso que lo motivo lo prueba: odoo_translate
# convivia con models.Field.translate, que orm/fields.py ya declaraba con el
# defecto de la fuente — dos nombres para lo mismo, y el prestado le ganaba el
# sitio al fiel.
# Nace SIN baseline: el arbol estaba en 0 al cablearlo.
# Script: scripts/check_identifier_reference_name.py.
if [[ "${#STAGED_PY[@]}" -gt 0 ]]; then
    REFNAME_CHECKER="$REPO_ROOT/scripts/check_identifier_reference_name.py"
    if [[ ! -f "$REFNAME_CHECKER" ]]; then
        echo "pre-commit: $REFNAME_CHECKER no encontrado — skip refname gate" >&2
    else
        python3 "$REFNAME_CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── check_bloqueo_declarado: el simbolo no portado nombra su bloqueador ─────
# "No lo porte porque falta que algo lo llame" es una ARISTA dirigida, y el
# orden de lo que queda sale de recorrer ese grafo. Mientras la razon viva en
# prosa libre no hay grafo: medido, 103 marcas y solo unas pocas con direccion.
# Baseline de deuda heredada; una marca nueva sin forma fija SI bloquea.
# Script: scripts/check_bloqueo_declarado.py.
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
    BLOQUEO_CHECKER="$REPO_ROOT/scripts/check_bloqueo_declarado.py"
    if [[ ! -f "$BLOQUEO_CHECKER" ]]; then
        echo "pre-commit: $BLOQUEO_CHECKER no encontrado — skip bloqueo gate" >&2
    else
        python3 "$BLOQUEO_CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── check_bloqueo_vigente: la causa del bloqueo sigue sin existir ───────────
# El gate de arriba mide la FORMA de la marca y declara su ceguera: no resuelve
# el destino. Este lo resuelve. Una marca de bloqueo es una afirmacion de
# estado fechada, asi que envejece sola y en silencio — y ademas saca el
# simbolo de la lista de pendientes, porque el gate de porte la absuelve.
# Episodio: image_shape de html_editor, bloqueado por tres simbolos que el
# arbol ya tenia desde el cierre de #285 (H-API-1021).
# Baseline de deuda heredada; una caducada nueva SI bloquea.
# Script: scripts/check_bloqueo_vigente.py.
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
    VIGENTE_CHECKER="$REPO_ROOT/scripts/check_bloqueo_vigente.py"
    if [[ ! -f "$VIGENTE_CHECKER" ]]; then
        echo "pre-commit: $VIGENTE_CHECKER no encontrado — skip vigencia gate" >&2
    else
        python3 "$VIGENTE_CHECKER" --strict "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── check_escape_sequences: ninguna cadena declara un escape que Python no ──
# conoce. Desde 3.12 emiten SyntaxWarning y la documentación anuncia que serán
# SyntaxError. Se colaban por docstrings con markup RST (``\ `` es el escape de
# espacio) y con comandos citados (``grep "a\|b"``): el módulo importa, la suite
# pasa, y el aviso se pierde en la salida. El arreglo es el prefijo r, nunca
# duplicar la barra — ambos casos necesitan el contenido verbatim.
# Script: scripts/check_escape_sequences.py.
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
    ESCAPE_CHECKER="$REPO_ROOT/scripts/check_escape_sequences.py"
    if [[ ! -f "$ESCAPE_CHECKER" ]]; then
        echo "pre-commit: $ESCAPE_CHECKER no encontrado — skip escape gate" >&2
    else
        python3 "$ESCAPE_CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── check_model_name_lookup: un modelo CONCRETO no puede chocar con la ──────
# sintaxis de lookup — ni guion bajo al inicio/final (models.E023) ni doble
# guion bajo (models.E024). Django lo comprueba, pero SÓLO al correr la suite
# entera: el ofensor de H-API-751 vivía en tests/unit/service/ y hacía fallar
# un caso de tests/unit/orm/, porque se registra en el registro de apps al
# importarse su módulo y en aislamiento no reproduce.
# Script: scripts/check_model_name_lookup.py.
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
    LOOKUP_CHECKER="$REPO_ROOT/scripts/check_model_name_lookup.py"
    if [[ ! -f "$LOOKUP_CHECKER" ]]; then
        echo "pre-commit: $LOOKUP_CHECKER no encontrado — skip lookup gate" >&2
    else
        python3 "$LOOKUP_CHECKER" "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

# ─── check_chain_combine: el eslabon que ENRIQUECE lleva combine= ────────────
# El relevo por defecto de chain_method invoca la previa solo si la nueva
# devolvio None, y un contenedor vacio no lo es: el eslabon lo da por respuesta
# buena y descarta lo que entrego la previa. Medido en res.users.settings, el
# de `web` arrancaba en {} y el formato perdia id y user — sin excepcion y sin
# simbolo ausente, con el gate de porte declarando el archivo completo.
# El idioma lo decide la REFERENCIA (return super() vs res = super(); res[x]),
# no el tipo de retorno. Baseline de deuda revisada; una llamada nueva SI
# bloquea. Script: scripts/check_chain_combine.py.
if [[ ${#STAGED_PY[@]} -gt 0 ]]; then
    COMBINE_CHECKER="$REPO_ROOT/scripts/check_chain_combine.py"
    if [[ ! -f "$COMBINE_CHECKER" ]]; then
        echo "pre-commit: $COMBINE_CHECKER no encontrado — skip combine gate" >&2
    else
        python3 "$COMBINE_CHECKER" --strict "${STAGED_PY[@]}" || EXIT_CODE=1
    fi
fi

if [[ "$EXIT_CODE" -ne 0 ]]; then
    echo "" >&2
    echo "pre-commit: gates fallaron. Corrige los problemas o usa" >&2
    echo "  git commit --no-verify" >&2
    echo "(solo emergencias documentadas)." >&2
fi

# ─── check_addon_cycles: direccion de dependencias entre addons (T-036) ─────
# Un addon fundacional (identidad, acceso, correo, catalogo) NO importa uno de
# negocio: en la referencia Odoo la dependencia apunta siempre hacia abajo.
# Ratchet sobre INVERSIONES_CONOCIDAS — falla solo ante una inversion NUEVA.
# Script: scripts/check_addon_cycles.py.
CYCLES_CHECKER="$REPO_ROOT/scripts/check_addon_cycles.py"
if [ -f "$CYCLES_CHECKER" ]; then
    if ! python3 "$CYCLES_CHECKER" >/dev/null 2>&1; then
        python3 "$CYCLES_CHECKER" >&2
        echo "pre-commit: inversion de dependencia nueva — commit bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# check_catalog_declaration: declaracion del catalogo L0 (SOL-100).
# Cada addon declara sus modulos/capacidades en authz_catalog.py; el seed solo
# recolecta. Este gate verifica que la declaracion sea coherente ANTES de que
# llegue a una DB: addon en INSTALLED_APPS, sin duenos duplicados, sin
# capacidades huerfanas, sin aristas depends hacia un modulo inexistente.
# Ese ultimo check es el que habria cazado H-API-106 (el modulo 'orders'
# sobrevivio al addon retirado con cuatro aristas colgando).
# Script: scripts/check_catalog_declaration.py.
CATALOG_CHECKER="$REPO_ROOT/scripts/check_catalog_declaration.py"
if [ -f "$CATALOG_CHECKER" ]; then
    if ! python3 "$CATALOG_CHECKER" >/dev/null 2>&1; then
        python3 "$CATALOG_CHECKER" >&2
        echo "pre-commit: declaracion de catalogo incoherente — commit bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# check_addon_names: procedencia de addon (H-API-119, reincidido en H-API-256).
# El eje NO es "existe en la referencia" — tener addons propios es legitimo.
# Lo que se exige es que cada addon que no resuelve por nombre DECLARE su
# procedencia en scripts/addon_provenance.txt citando un documento que exista;
# el gate verifica la existencia del archivo, no interpreta su contenido.
# Los renames que Django fuerza (auth -> authz) los conoce el script.
NAMES_CHECKER="$REPO_ROOT/scripts/check_addon_names.py"
if [ -f "$NAMES_CHECKER" ]; then
    if ! python3 "$NAMES_CHECKER" >/dev/null 2>&1; then
        python3 "$NAMES_CHECKER" >&2
        echo "pre-commit: addon sin procedencia declarada — commit bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 7: capas estructurales en paquete, no planas (H-API-238). El mapa ya
# esta decidido (views/serializers/urls/schema -> controllers/, data -> data/,
# authz_catalog -> security/); este gate solo impide que aparezcan planos
# NUEVOS. Mover un plano de un addon a otro no lo saca de la deuda: lo renombra
# — que es exactamente como reincidio en H-API-256.
LAYOUT_CHECKER="$REPO_ROOT/scripts/check_addon_layout.py"
if [ -f "$LAYOUT_CHECKER" ]; then
    if ! python3 "$LAYOUT_CHECKER" >/dev/null 2>&1; then
        python3 "$LAYOUT_CHECKER" >&2
        echo "pre-commit: capa estructural plana nueva — commit bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 8: la URLConf resuelve entera (H-API-376).
# Ninguno de los gates anteriores importa las rutas, y `django.setup()` tampoco
# — leido del binario, solo hace logging + script prefix + apps.populate(). La
# URLConf de Django es perezosa. Por eso api@31c2470 pudo commitear un urls.py
# que importaba tres simbolos que su session.py no definia: el registro
# arrancaba verde y el ImportError esperaba a la primera peticion.
# Cuesta ~1.9 s, el mismo orden que el gate de lazy imports (~1.5 s).
# Script: scripts/check_urlconf.py (se re-lanza solo bajo .venv).
URLCONF_CHECKER="$REPO_ROOT/scripts/check_urlconf.py"
if [ -f "$URLCONF_CHECKER" ] && [ ${#STAGED_PY[@]} -gt 0 ]; then
    if ! python3 "$URLCONF_CHECKER" >/dev/null 2>&1; then
        python3 "$URLCONF_CHECKER" >&2
        echo "pre-commit: la URLConf no resuelve — commit bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 9: el simbolo vive del lado que la referencia declara (H-API-556).
# Ninguno de los gates anteriores mira DONDE aterriza un porte: el de layout
# (7) mide la forma dentro del addon, el de porte completo mide simbolos
# dentro de un archivo emparejado. Por eso api@61b7651 pudo poner
# base_sparse_field en src/orm/ con su suite verde: `class Serialized` da 0
# hits en odoo19c: odoo/orm/ y 1 en addons/base_sparse_field/, y nada lo medía.
# Probado contra ese caso real: reponerlo en src/orm/ da exit 1.
# Ratchet sobre UBICACIONES_ACEPTADAS — falla solo ante una ubicacion NUEVA.
# Sin el arbol de la referencia informa y sale 0 (no mide el entorno de nadie).
# Script: scripts/check_symbol_home.py.
SYMBOL_HOME_CHECKER="$REPO_ROOT/scripts/check_symbol_home.py"
if [ -f "$SYMBOL_HOME_CHECKER" ] && [ ${#STAGED_PY[@]} -gt 0 ]; then
    if ! python3 "$SYMBOL_HOME_CHECKER" --strict >/dev/null 2>&1; then
        python3 "$SYMBOL_HOME_CHECKER" --strict >&2
        echo "pre-commit: simbolo fuera del lado que declara la referencia" >&2
        echo "  Si la ubicacion es correcta, declararla en" >&2
        echo "  UBICACIONES_ACEPTADAS con su motivo MEDIDO — no vaciarla." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 10: un addon vive en UNA sola raiz de ADDONS_PATHS (H-API-572).
# El namespace `addons` abarca las dos raices, asi que un addon partido entre
# ellas resuelve contra la primera y la otra copia queda muerta: sin
# ImportError, sin fallo de arranque, sin test rojo. Su forma canonica es un
# merge — una rama reubica el addon y otra anade archivos nuevos en la ruta
# vieja, que git no puede aparear.
# Script: scripts/check_addon_root.py.
ROOT_CHECKER="$REPO_ROOT/scripts/check_addon_root.py"
if [ -f "$ROOT_CHECKER" ]; then
    if ! python3 "$ROOT_CHECKER" --strict >/dev/null 2>&1; then
        python3 "$ROOT_CHECKER" --strict >&2
        echo "pre-commit: addon partido entre raices — commit bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 11: quien encadena un metodo declara al addon que lo declara (H-API-564).
# chain_method arma la cadena en ready(), y ready() corre en el orden de
# INSTALLED_APPS, que sale del grafo depends. Si el dueno del simbolo no esta
# en el depends del que encadena, el orden queda indefinido y su setattr puede
# sepultar la cadena en silencio. Un depends medido por imports NO lo ve: la
# arista que importa es la del simbolo, no la del modulo.
# Script: scripts/check_chain_method_depends.py.
CHAIN_CHECKER="$REPO_ROOT/scripts/check_chain_method_depends.py"
if [ -f "$CHAIN_CHECKER" ]; then
    if ! python3 "$CHAIN_CHECKER" --strict >/dev/null 2>&1; then
        python3 "$CHAIN_CHECKER" --strict >&2
        echo "pre-commit: chain_method sin el dueno en depends — bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 12: una pieza de trabajo del banco declara donde aterriza lo que produce.
# scripts/workbench/<slug>-<ISO>/ guarda el instrumento y su evidencia; el
# documento publicable vive en docs. Sin manifest.json con sus cinco claves
# —question, instrument, metric, blind_to, destination— el trabajo produce una
# cifra que nadie puede situar, y una salida que nadie encuentra.
# Nace SIN baseline: el directorio arranco vacio, asi que no hay deuda que
# congelar (directiva del ejecutor 2026-08-30, tarea #219).
# Script: scripts/check_workbench.py.
BENCH_CHECKER="$REPO_ROOT/scripts/check_workbench.py"
if [ -f "$BENCH_CHECKER" ]; then
    if ! python3 "$BENCH_CHECKER" --strict >/dev/null 2>&1; then
        python3 "$BENCH_CHECKER" --strict >&2
        echo "pre-commit: pieza de trabajo sin manifiesto completo — bloqueado" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Gate 13: un atributo de clase de campo responde lo que la fuente declara.
# `orm.fields` instala 45 atributos sobre `models.Field` con el defecto que la
# fuente pone en su clase base. La fuente ademas los SOBRESCRIBE por clase
# concreta, y si esas sobrescrituras no se instalan el atributo existe,
# responde, y responde mal — ningun gate de porte lo ve ausente porque no lo
# esta. Cayo asi `falsy_value` (h-api-970), y lo destapo un consumidor al
# portarse, no una auditoria.
#
# Solo dispara si el commit toca el contrato de campo o el mapa de porte: es
# el unico gate que arranca Django (~2.6 s), y cobrarselo a un commit de docs
# es como se aprende a saltarse un hook.
# Script: scripts/check_field_class_attributes.py (con baseline de deuda).
ATTR_CHECKER="$REPO_ROOT/scripts/check_field_class_attributes.py"
TOCA_CONTRATO=$(printf '%s\n' "${STAGED_PY[@]:-}" \
    | grep -cE 'src/orm/fields(_[a-z]+)?\.py$' || true)
if [ -f "$ATTR_CHECKER" ] && [ "$TOCA_CONTRATO" -gt 0 ]; then
    if ! uv run python "$ATTR_CHECKER" --strict >/dev/null 2>&1; then
        uv run python "$ATTR_CHECKER" --strict >&2
        echo "pre-commit: un atributo de clase responde distinto de la fuente — bloqueado" >&2
        exit 1
    fi
fi

# --- Gate 20: un reclamo de cero que el porte dejo falso (#228) ---------------
# Un docstring declina un porte citando su propio comando: `grep ... src/` -> 0.
# Esa razon es correcta al escribirse y CADUCA SOLA: el dia que alguien porta
# lo que el grep buscaba, la prosa sigue diciendo cero. Cuatro declinaciones
# seguidas resultaron apoyarse en un cero caducado (H-API-981..984), y las
# cuatro se encontraron leyendo archivo por archivo.
#
# El gate re-ejecuta el comando que el texto dice haber corrido. No adivina el
# simbolo: corre la cita. Deuda heredada congelada en
# scripts/stale_zero_claims_baseline.txt — una listada no bloquea, una nueva si.
# Script: scripts/check_stale_zero_claims.py.
STALE_CHECKER="$REPO_ROOT/scripts/check_stale_zero_claims.py"
if [ -f "$STALE_CHECKER" ] && [ "${#STAGED_PY[@]}" -gt 0 ]; then
    if ! python3 "$STALE_CHECKER" --strict "${STAGED_PY[@]}" >/dev/null 2>&1; then
        python3 "$STALE_CHECKER" --strict "${STAGED_PY[@]}" >&2
        echo "pre-commit: un reclamo de cero ya no vale — re-medir la razon, no borrarla" >&2
        exit 1
    fi
fi

# ─── check_write_path: el porte escribe por el mismo camino que la fuente ────
# H-API-1058: un reflejo escribia con `update_or_create` —cruzando la guarda de
# `save()`— donde la fuente escribe con SQL crudo a proposito. Ninguno de los
# otros gates lo veia: miden presencia, cabecera, sitio o nombre, no el CUERPO.
# Baseline de deuda heredada; una divergencia NUEVA de camino SI bloquea.
# El gate rehusa sin la raiz de la referencia en vez de publicar un 0 falso, y
# ese rehuse no debe bloquear un commit: se avisa y se sigue.
# Script: scripts/check_write_path.py (eje sobre scripts/counterpart_body.py).
WRITE_PATH_CHECKER="$REPO_ROOT/scripts/check_write_path.py"
if [ -f "$WRITE_PATH_CHECKER" ] && [ "${#STAGED_PY[@]}" -gt 0 ]; then
    WRITE_PATH_OUT=$(python3 "$WRITE_PATH_CHECKER" --strict "${STAGED_PY[@]}" 2>&1)
    WRITE_PATH_RC=$?
    if [ "$WRITE_PATH_RC" -eq 2 ]; then
        echo "pre-commit: sin la raiz de la referencia no se mide el camino de escritura — skip" >&2
    elif [ "$WRITE_PATH_RC" -eq 0 ]; then
        # El denominador se publica tambien en verde: un OK mudo no distingue
        # "no hay divergencias" de "el gate no llego a correr".
        echo "$WRITE_PATH_OUT"
    else
        echo "$WRITE_PATH_OUT" >&2
        echo "pre-commit: el porte escribe por otro camino que la fuente." >&2
        echo "  Si la divergencia es deliberada, declararla en el docstring y" >&2
        echo "  anadirla al baseline con --write-baseline; si no, corregir el camino." >&2
        EXIT_CODE=1
    fi
fi

exit "$EXIT_CODE"
